# Server configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database connections (Supabase Postgres)
# DATABASE_URL: pooled connection via Supabase Transaction Pooler (port 6543) with pgbouncer=true and connection_limit=5
DATABASE_URL="postgresql://postgres.projectref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL: direct connection (port 5432) for DDL / migrations only
DIRECT_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres"

# Security & Permissions
# Comma-separated list of numeric GitHub User IDs allowed administrative access
ADMIN_GITHUB_USER_IDS=174175300
# Comma-separated allowlist of origins for CORS (never "*")
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# Cryptographically secure random secret (min 32 chars) for cookie signing
SESSION_SECRET=change_me_to_a_secure_random_32_char_secret_key_12345

# GitHub App integration (Track B - Phases B2/B5)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_BOT_USER_ID=
SWEEP_SECRET=
FINAL_DEADLINE=
